    {
      "title": "OpenWebUI Memory Projection (30-day)",
      "description": "Current memory usage with 30-day linear projection. Dashed line shows where memory will be in 30 days at current growth rate.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "30-day projection"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory Limit (5GB)"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    5,
                    5
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=\"chat-openwebui\"}",
          "legendFormat": "Current Usage",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "expr": "predict_linear(container_memory_usage_bytes{name=\"chat-openwebui\"}[7d], 86400 * 30)",
          "legendFormat": "30-day projection",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "expr": "container_memory_limit_bytes{name=\"chat-openwebui\"}",
          "legendFormat": "Memory Limit (5GB)",
          "refId": "C",
          "range": true,
          "instant": false
        }
      ],
      "id": 6
    },
