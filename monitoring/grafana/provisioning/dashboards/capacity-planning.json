        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "rate(node_vmstat_pswpin[5m]) + rate(node_vmstat_pswpout[5m])",
          "legendFormat": "Swap I/O ops/s",
          "refId": "A"
        }
